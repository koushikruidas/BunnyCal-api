# =============================================================================
# BunnyCal — PRODUCTION runtime configuration TEMPLATE
# =============================================================================
# Copy to `.env` and fill in real values:  cp .env.example .env
# The real `.env` is git-ignored and is the single source of truth consumed by
# docker-compose.yaml. Every variable the app reads in the `prod` profile is
# listed here. Values marked FAIL-FAST have NO insecure default — the app will
# refuse to boot if they are missing.
# =============================================================================

# ----------------------------------------------------------------------------
# Deployment / Docker
# ----------------------------------------------------------------------------
APP_DOMAIN=api.example.com
BUNNYCAL_IMAGE=bunnycal/bunnycal-api:latest
SPRING_PROFILES_ACTIVE=prod

# ----------------------------------------------------------------------------
# Database (Postgres) — MANAGED, not in Compose (FAIL-FAST)
# ----------------------------------------------------------------------------
# Postgres runs on the DOCKER HOST (installed from the PGDG apt repo — see
# docs/runbooks/vm-provisioning.md), not in a container and not on a managed
# provider. We own backups and PITR via pgBackRest; see DEPLOYMENT.md §9.
# All three values below are REQUIRED — the app will not boot without them.
#
# 172.30.0.1 is the gateway of the pinned bunnycal network in
# docker-compose.yaml — the host's own address on that bridge, and what
# listen_addresses binds. sslmode=disable is CORRECT here: the connection never
# leaves the machine.
#
# Do NOT use host.docker.internal. Via extra_hosts: host-gateway it resolves to
# the DEFAULT bridge gateway (172.17.0.1) no matter which network the container
# joins, so on this stack it points at an interface Postgres does not listen on
# and every connection is refused before authentication.
#
# ⚠️  Coupled to the compose subnet. Changing it means changing this URL,
# listen_addresses, and the pg_hba.conf host rule together.
#
# ⚠️  If the database ever moves off this host, switch to sslmode=verify-full in
# the same change — and keep it in the SAME region as the app, because a booking
# write makes several round trips (SELECT ... FOR UPDATE plus partition EXCLUDE
# checks), so latency is multiplied rather than merely added.
SPRING_DATASOURCE_URL=jdbc:postgresql://172.30.0.1:5432/bunnycal?sslmode=disable
SPRING_DATASOURCE_USERNAME=bunnycal
# Generate: openssl rand -hex 32
#
# HEX, not base64. This same password is embedded in BACKUP_DATABASE_URL below
# as a libpq URI, and the base64 alphabet contains `/` and `+` — URI delimiters
# that break the connection string unless percent-encoded. 64 hex chars is 256
# bits, stronger than the base64 form, and safe everywhere without escaping.
SPRING_DATASOURCE_PASSWORD=change_me_strong_password

# ----------------------------------------------------------------------------
# Redis — cache only, service-name networking inside the Compose network
# ----------------------------------------------------------------------------
# Nothing in Redis is a source of truth (slot cache, slot version counters,
# OAuth access-token cache — all TTL'd, all fail open to Postgres), so it is
# never backed up and runs with persistence disabled.
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
# Required. Sets requirepass on the Redis container and authenticates the app.
# Generate: openssl rand -base64 32
REDIS_PASSWORD=change_me_strong_password

# ----------------------------------------------------------------------------
# Core application secrets (FAIL-FAST)
# ----------------------------------------------------------------------------
# Generate: openssl rand -base64 48 | tr '/+' '_-'
JWT_SECRET=replace_with_32_plus_char_secret
JWT_EXPIRATION=3600000
CALENDAR_WEBHOOK_SHARED_SECRET=replace_with_long_random_secret
# Generate: openssl rand -base64 32   (must decode to exactly 32 bytes)
CALENDAR_TOKEN_ENCRYPTION_KEY_BASE64=replace_with_base64_32_byte_key
CALENDAR_OAUTH_STATE_SECRET=replace_with_long_random_secret

# ----------------------------------------------------------------------------
# Email (SMTP) — FAIL-FAST (username/password)
# ----------------------------------------------------------------------------
# Port 587 (recommended): STARTTLS is enabled and required by default.
SPRING_MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_SSL_ENABLE=false
MAIL_SMTP_SSL_CHECK_SERVER_IDENTITY=true
# Legacy credential names are still accepted when the generic names above are absent.
# Do not define the generic names as blank when relying on these legacy variables.
# AWS_SES_SMTP_USERNAME=
# AWS_SES_SMTP_PASSWORD=
BOOKING_NOTIFICATIONS_FROM=calendar@example.com
BOOKING_NOTIFICATIONS_CALENDAR_ORGANIZER_EMAIL=calendar@example.com
BOOKING_NOTIFICATIONS_CALENDAR_ORGANIZER_NAME=BunnyCal Calendar

# ----------------------------------------------------------------------------
# Billing (Stripe) — SaaS subscription billing (Phase 1)
# Leave BILLING_ENABLED=false to boot without Stripe (dev/test).
# ----------------------------------------------------------------------------
BILLING_ENABLED=false
BILLING_ADMIN_ENABLED=false
BILLING_NOTIFICATIONS_ENABLED=false
BILLING_GRACE_DAYS=3
BILLING_NOTIFICATIONS_FROM=billing@example.com
BILLING_NOTIFICATIONS_FROM_NAME=BunnyCal Billing
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=http://localhost:5173/dashboard/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:5173/dashboard/billing?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/dashboard/billing

# ----------------------------------------------------------------------------
# Host-direct event payments — separate from subscription billing
# Configure the webhook as a Connect endpoint for events on connected accounts.
# Leave COMMERCE_ENABLED=false until Connect onboarding and webhook secrets are ready.
# ----------------------------------------------------------------------------
COMMERCE_ENABLED=false
COMMERCE_STRIPE_SECRET_KEY=sk_test_replace_me
COMMERCE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
COMMERCE_STRIPE_WEBHOOK_SECRET=whsec_replace_me
COMMERCE_STRIPE_ONBOARDING_RETURN_URL=http://localhost:5173/dashboard/integrations?payment=connected
COMMERCE_STRIPE_ONBOARDING_REFRESH_URL=http://localhost:5173/dashboard/integrations?payment=refresh

# PayPal multiparty commerce requires approved PayPal partner credentials. Keep this
# disabled until the partner app, seller onboarding and webhook are provisioned.
COMMERCE_PAYPAL_ENABLED=false
COMMERCE_PAYPAL_CLIENT_ID=
COMMERCE_PAYPAL_CLIENT_SECRET=
COMMERCE_PAYPAL_PARTNER_MERCHANT_ID=
COMMERCE_PAYPAL_PARTNER_ATTRIBUTION_ID=
COMMERCE_PAYPAL_WEBHOOK_ID=
COMMERCE_PAYPAL_ONBOARDING_RETURN_URL=http://localhost:5173/dashboard/integrations?payment=paypal
COMMERCE_PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
COMMERCE_RECONCILIATION_FIXED_DELAY_MS=30000

# ----------------------------------------------------------------------------
# Google OAuth / Calendar — FAIL-FAST (client id/secret)
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/integrations/calendar/google/callback
GOOGLE_WEBHOOK=https://api.example.com/integrations/calendar/webhooks/google

# ----------------------------------------------------------------------------
# Microsoft OAuth / Calendar (optional — leave blank to disable)
# ----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://api.example.com/integrations/calendar/microsoft/callback
MICROSOFT_WEBHOOK=https://api.example.com/integrations/calendar/webhooks/microsoft

# ----------------------------------------------------------------------------
# Calendar Sync — sweep parallelism & webhook-fresh poll gating (optional)
# ----------------------------------------------------------------------------
# Parallelize the calendar sync sweep (raises the connected-calendar ceiling).
# Default false; set true to enable. Revertable via this flag with no redeploy.
CALENDAR_SYNC_PARALLEL_ENABLED=false
CALENDAR_SYNC_PARALLELISM=8
# Hard per-sweep deadline; MUST stay well below the scheduler lockAtMostFor (PT2M).
CALENDAR_SYNC_SWEEP_MAX_RUNTIME=PT25S
# Poll fresh-webhook connections only on the backstop cadence instead of every tick.
# Only safe while webhook delivery is healthy. Default false.
CALENDAR_SYNC_WEBHOOK_FRESH_GATING_ENABLED=false
CALENDAR_SYNC_WEBHOOK_FRESH_BACKSTOP=PT15M
# Capture raw inbound webhook payloads into calendar_webhook_replay_fixtures for
# replay debugging. Defaults to TRUE in the prod profile and there is no purge
# job, so it grows without bound and inflates every backup. Keep it off unless
# actively debugging a provider issue.
CALENDAR_WEBHOOK_REPLAY_CAPTURE_ENABLED=false

# ----------------------------------------------------------------------------
# Zoom OAuth / Conferencing (optional — leave blank to disable)
# Local dev: Zoom rejects the hostname "localhost" but allows http://127.0.0.1,
# so the local redirect must be
# http://127.0.0.1:8080/integrations/conferencing/zoom/callback (added to the
# app's OAuth Allow List). See docs/zoom-marketplace-submission.md.
# ----------------------------------------------------------------------------
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://api.example.com/integrations/conferencing/zoom/callback
ZOOM_FRONTEND_SUCCESS_REDIRECT=https://app.example.com/dashboard/integrations
ZOOM_FRONTEND_ERROR_REDIRECT=https://app.example.com/calendar-error
# Secret Token from the Zoom app (Features > Access); verifies deauthorization webhooks
# delivered to /integrations/conferencing/zoom/webhooks.
ZOOM_WEBHOOK_SECRET_TOKEN=

# ----------------------------------------------------------------------------
# Public URLs / CORS — production domains only, no localhost.
# ----------------------------------------------------------------------------
FRONTEND_BASE_URL=https://app.example.com
APP_PUBLIC_BASE_URL=https://app.example.com
APP_SECURITY_CORS_ALLOWED_ORIGINS=https://app.example.com
APP_DOCS_PUBLIC_ENABLED=false

# ----------------------------------------------------------------------------
# Observability (disabled by default — set ENABLED=true and uncomment compose services to re-enable)
# ----------------------------------------------------------------------------
MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED=false
# MANAGEMENT_OTLP_METRICS_EXPORT_URL=http://otel-collector:4318/v1/metrics
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change_me_strong_password

# ----------------------------------------------------------------------------
# Backups — consumed by scripts/backup/pg-dump-nightly.sh, NOT by the app
# ----------------------------------------------------------------------------
# TWO LAYERS, covering different failures. Neither replaces the other:
#
#   1. pgBackRest (physical base backups + continuous WAL) — the LOW-RPO layer,
#      ~5 minutes. Configured in /etc/pgbackrest/pgbackrest.conf on the host,
#      NOT here. See deploy/pgbackrest/pgbackrest.conf.example.
#
#   2. These nightly logical dumps — the PORTABLE layer. They restore into any
#      PG16+ anywhere, which makes them the major-version-upgrade and
#      provider-migration mechanism, and the fallback if the pgBackRest repo is
#      itself corrupt or its passphrase is lost.
#
# A logical dump CANNOT be the base for WAL replay — that needs a physical
# backup, which is what pgBackRest provides. The two layers are not redundant.
#
# Store both with a DIFFERENT vendor than the VM. That separation is the entire
# point — same-vendor backups die with the account.

# libpq connection string for pg_dump. Same database as SPRING_DATASOURCE_URL
# but in libpq form (postgresql://, not jdbc:postgresql://).
#
# The dump runs ON the database host, so this is a loopback connection and
# sslmode=disable is correct — matching SPRING_DATASOURCE_URL above.
#
# ⚠️ The password here is the SAME one as SPRING_DATASOURCE_PASSWORD, but
# embedded in a URI. Rotating the role password means changing it in BOTH
# places — updating only the Spring variable leaves the app working while the
# nightly dump fails silently at 03:00. If the password contains any of
# / + @ : ? # it must be percent-encoded here; generating it with
# `openssl rand -hex 32` avoids the problem entirely.
BACKUP_DATABASE_URL=postgresql://bunnycal:change_me@127.0.0.1:5432/bunnycal?sslmode=disable

# age PUBLIC key (age1...). Dumps are encrypted before upload so the storage
# vendor never sees plaintext PII. Generate: age-keygen -o backup-age.key
# Keep the PRIVATE key in your password manager AND on paper — without it the
# backups are landfill.
BACKUP_AGE_PUBLIC_KEY=age1replace_with_your_public_key

# rclone remote:path for off-site upload. Configure with: rclone config
#
# Keep this in the EU (eu-north-1, matching the pgBackRest repo): the dump
# contains every user's PII and the VM is in Helsinki, so an out-of-region
# bucket would create an international personal-data transfer under GDPR.
BACKUP_RCLONE_REMOTE=s3-eu-north:bunnycal-pgdumps-eunorth1/dumps

# Local staging dir for the dump before upload.
BACKUP_LOCAL_DIR=/var/backups/bunnycal

# Keep this many daily dumps locally; monthly (1st of month) dumps are kept
# indefinitely. Remote retention is configured at the storage vendor.
BACKUP_RETAIN_DAYS=14

# Dead-man's-switch ping URL (healthchecks.io / Cronitor). Pinged ONLY on full
# success. If no ping arrives within the grace period you get an email. This is
# the entire monitoring story for backups — no Prometheus required.
BACKUP_HEALTHCHECK_URL=

# ----------------------------------------------------------------------------
# pgBackRest — NOT configured here
# ----------------------------------------------------------------------------
# The repository credentials and encryption passphrase live in
# /etc/pgbackrest/pgbackrest.conf on the host (root/postgres-owned, mode 0640),
# deliberately outside this file: those units run as the `postgres` user, which
# must not be able to read the application's secrets.
#
# Template:  deploy/pgbackrest/pgbackrest.conf.example
# Setup:     docs/runbooks/vm-provisioning.md
#
# Its separate dead-man's-switch for the hourly archive check goes in
# /etc/pgbackrest/healthcheck.env as:
#   PGBACKREST_HEALTHCHECK_URL=https://hc-ping.com/...
